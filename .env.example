# Copy to .env and fill in what you have. Every key is optional:
# anything missing falls back to demo behaviour and the UI says so.

# --- Sarvam AI: speech-to-text (Assamese, Bodo, Manipuri, Nepali, Bengali, Hindi),
#     translation, and Hindi/Bengali/English voice. https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# --- LLM: any OpenAI-compatible API. Default is Groq (free tier). https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Alternatives: openai/gpt-oss-120b on Groq; or a local Ollama: LLM_BASE_URL=http://localhost:11434/v1

# --- Groq Whisper as a fallback speech-to-text (defaults to LLM_API_KEY if blank)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Self-hosted AI4Bharat Indic Parler-TTS for Assamese/Bodo/Manipuri/Nepali voice
#     (run tts_server/parler_server.py on a Kaggle/Colab GPU, expose with ngrok)
PARLER_TTS_URL=

# --- Twilio real phone line (optional). PUBLIC_BASE_URL = your ngrok https URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true

HTTP_TIMEOUT=20
SESSION_TTL_SECONDS=1800
