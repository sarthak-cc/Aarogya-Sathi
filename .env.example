# Copy to .env and fill in. Keys stay on the server and are never sent to the browser.
# Anything missing is reported honestly in the app; nothing is faked.

# --- LLM (required for answers). Groq free tier: https://console.groq.com/keys
# Groq retired llama-3.3-70b-versatile in Aug 2026; gpt-oss-120b is its suggested replacement.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=30

# --- Camera prototype: Groq vision (photo analysis). Uses GROQ_API_KEY below; separate from the text LLM.
# qwen/qwen3.8-27b accepts images on Groq (max 3 per request, base64 requests up to 4 MB). "none" = instruct mode.
VISION_MODEL=qwen/qwen3.8-27b
VISION_REASONING_EFFORT=none
VISION_TIMEOUT=45
VISION_MAX_UPLOAD_MB=8

# --- Sarvam AI (required for Indian languages): speech-to-text, translation, Hindi/Bengali/English voice.
# https://dashboard.sarvam.ai  (new accounts get free starter credits; check current pricing)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_VOICE_ID=

# --- Groq Whisper as a second speech-to-text option for en/hi/bn/ne (defaults to the Groq LLM key)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Optional voices for Assamese / Nepali (Sarvam has none):
# Local open-source MMS-TTS on CPU: pip install -r requirements-tts.txt, then e.g. MMS_TTS_LANGS=as-IN,ne-IN
MMS_TTS_LANGS=
# Or a self-hosted Indic Parler-TTS GPU server (tts_server/parler_server.py)
PARLER_TTS_URL=

# --- Nearby facilities: OpenStreetMap (free, no key). Put a contact (email or repo URL) per the usage policy.
OSM_ENABLED=true
OSM_CONTACT=
DB_PATH=

HTTP_TIMEOUT=20
SESSION_TTL_SECONDS=3600
